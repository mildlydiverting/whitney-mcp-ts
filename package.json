{
  "name": "whitney-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the Whitney Museum of American Art public API (artists, artworks, exhibitions, events)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "whitney-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "whitney",
    "museum",
    "open-access"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
